# Solo para el servidor; nunca usar variables VITE_ para credenciales.
GCLOUD_PROJECT=sistema-reservas-jf745-2026
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ruta absoluta a un archivo fuera del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta-privada/firebase-service-account.json

# Cloudinary: solo servidor, nunca VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notificaciones de solicitudes de negocio (Resend). Configurar después de verificar el dominio remitente.
RESEND_API_KEY=
RESEND_FROM=CitasPro <no-reply@tu-dominio-verificado.com>
APP_PUBLIC_URL=https://sistema-reservas-jf745-2026.web.app
# 32 bytes aleatorios codificados en base64; mantener estable para descifrar enlaces pendientes.
BUSINESS_REQUEST_TOKEN_ENCRYPTION_KEY=
