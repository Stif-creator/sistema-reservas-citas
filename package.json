{
  "name": "sistema-generico-de-reservas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/hours.test.js tests/availability.test.js tests/platform.test.js tests/analytics.test.js tests/unsavedForms.test.js tests/client-booking.test.js tests/reservations-filters.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-citaspro \"node --test --test-concurrency=1 tests/firestore.test.js tests/production-rules.test.js\"",
    "test:rules:production": "firebase emulators:exec --only firestore --project demo-citaspro \"node --test tests/production-rules.test.js\"",
    "test:ui": "firebase emulators:exec --only auth,firestore --project demo-citaspro \"playwright test\"",
    "test:booking": "firebase emulators:exec --only firestore --project demo-citaspro \"node --test tests/booking.test.js\"",
    "demo": "firebase emulators:exec --only auth,firestore --project demo-citaspro \"node scripts/dev-demo.mjs\"",
    "test:http": "node --test tests/booking-http.test.js tests/images.test.js tests/booking-transport.test.js",
    "server": "node --env-file=.env.server functions/server.js"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "firebase-tools": "^15.30.2",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
