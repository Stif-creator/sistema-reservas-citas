rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function userActive() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function superadmin() {
      return userActive() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('globalRole', 'user') == 'superadmin';
    }
    function hexColor(value) {
      return value is string && value.matches('^#[0-9a-fA-F]{6}$');
    }
    function validAppearance(appearance) {
      return appearance is map
        && appearance.keys().hasOnly(['primaryColor', 'secondaryColor', 'accentColor', 'surfaceColor'])
        && appearance.keys().hasAll(['primaryColor', 'secondaryColor', 'accentColor', 'surfaceColor'])
        && hexColor(appearance.primaryColor)
        && hexColor(appearance.secondaryColor)
        && hexColor(appearance.accentColor)
        && hexColor(appearance.surfaceColor);
    }
    function validLocation(location) {
      return location == null || (location is map
        && ((location.get('latitude', null) == null && location.get('longitude', null) == null)
          || (location.get('latitude', null) is number
            && location.get('longitude', null) is number
            && location.latitude >= -85 && location.latitude <= 85
            && location.longitude >= -180 && location.longitude <= 180)));
    }
    function publicBusiness(bid) {
      let business = get(/databases/$(database)/documents/businesses/$(bid)).data;
      return business.status == 'active' && business.settings.publicPageEnabled == true;
    }
    function member(bid) {
      return get(/databases/$(database)/documents/memberships/$(bid + '_' + request.auth.uid)).data;
    }
    function activeMember(bid) {
      return userActive() && member(bid).status == 'active'
        && get(/databases/$(database)/documents/businesses/$(bid)).data.status == 'active';
    }
    function admin(bid) { return superadmin() || (activeMember(bid) && member(bid).role == 'admin'); }
    function professional(bid) {
      return activeMember(bid) && member(bid).role == 'professional';
    }
    function ownProfessional(bid, pid) {
      let profile = get(/databases/$(database)/documents/professionals/$(pid)).data;
      return profile.businessId == bid && profile.userId == request.auth.uid;
    }
    function recent(data) { return data.createdAt > request.time - duration.value(10, 'm'); }
    function provisioning() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('onboardingComplete', true) == false;
    }
    function sameIdentity() {
      return request.resource.data.businessId == resource.data.businessId
        && request.resource.data.get('id', null) == resource.data.get('id', null);
    }
    function professionalMatches(businessId, uid, role, status) {
      let membership = getAfter(/databases/$(database)/documents/memberships/$(businessId + '_' + uid)).data;
      let pid = membership.get('professionalId', businessId + '_' + uid);
      let path = /databases/$(database)/documents/professionals/$(pid);
      return role == 'professional'
        ? (existsAfter(path) && getAfter(path).data.userId == uid && getAfter(path).data.businessId == businessId
          && getAfter(path).data.isActive == (status == 'active'))
        : (!existsAfter(path) || (getAfter(path).data.userId == uid && getAfter(path).data.businessId == businessId && getAfter(path).data.isActive == false));
    }
    function managesProfile(id) {
      return signedIn() && admin(get(/databases/$(database)/documents/memberships/$(id)).data.businessId);
    }
    match /users/{uid} {
      allow read: if superadmin() || self(uid) || (signedIn() && admin(resource.data.businessIds[0])
        && exists(/databases/$(database)/documents/memberships/$(resource.data.businessIds[0] + '_' + uid)));
      allow create: if signedIn() && request.resource.data.businessIds is list
        && request.resource.data.businessIds.size() == 1
        && admin(request.resource.data.businessIds[0])
        && request.resource.data.id == uid && request.resource.data.auth_uid == uid
        && request.resource.data.globalRole == 'user' && request.resource.data.status == 'active'
        && request.resource.data.onboardingComplete == true
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.businessIds[0] + '_' + uid)).data.role == 'professional';
      allow create: if self(uid) && request.resource.data.id == uid
        && request.resource.data.auth_uid == uid
        && request.resource.data.globalRole == 'user'
        && request.resource.data.onboardingComplete == false
        && request.resource.data.status == 'active'
        && request.resource.data.businessIds is list && request.resource.data.businessIds.size() == 1
        && request.resource.data.createdAt == request.time;
      allow update: if self(uid) && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['firstName', 'lastName', 'phone', 'photoUrl', 'lastLoginAt', 'updatedAt', 'mustChangePassword'])
        || (self(uid) && resource.data.get('onboardingComplete', true) == false
          && request.resource.data.onboardingComplete == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboardingComplete'])
          && exists(/databases/$(database)/documents/memberships/$(resource.data.businessIds[0] + '_' + uid)));
      allow delete: if self(uid) && recent(resource.data) && provisioning();
    }
    // This collection contains the public business profile. Never store secrets here.
    match /businesses/{bid} {
      allow read: if superadmin() || (resource.data.status == 'active' && resource.data.settings.publicPageEnabled == true)
        || (signedIn() && (resource.data.ownerUserId == request.auth.uid || activeMember(bid)));
      allow create: if userActive() && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.id == bid && request.resource.data.status == 'active'
        && (superadmin() || !('appearance' in request.resource.data) || request.resource.data.appearance == { 'primaryColor': '#1672ed', 'secondaryColor': '#eaf3ff' })
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessIds == [bid]
        && request.resource.data.createdAt == request.time;
      allow update: if admin(bid)
        && (superadmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'appearance']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['appearance'])
          || (superadmin() && validAppearance(request.resource.data.appearance)))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['location'])
          || validLocation(request.resource.data.location))
        && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'description', 'about', 'logo', 'cover', 'appearance', 'contact', 'location', 'weeklyHours', 'settings', 'updatedAt']);
      allow delete: if signedIn() && resource.data.ownerUserId == request.auth.uid && recent(resource.data) && provisioning();
    }
    match /memberships/{mid} {
      allow read: if self(resource.data.userId) || admin(resource.data.businessId);
      allow create: if admin(request.resource.data.businessId)
        && mid == request.resource.data.businessId + '_' + request.resource.data.userId
        && request.resource.data.role == 'professional' && request.resource.data.status == 'active'
        && request.resource.data.permissions == {} && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.businessIds == [request.resource.data.businessId]
        && professionalMatches(request.resource.data.businessId, request.resource.data.userId, 'professional', 'active');
      allow create: if userActive() && self(request.resource.data.userId)
        && mid == request.resource.data.businessId + '_' + request.auth.uid
        && request.resource.data.permissions == {}
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.role == 'admin' && request.resource.data.status == 'active'
            && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerUserId == request.auth.uid)
          || (publicBusiness(request.resource.data.businessId)
            && ((request.resource.data.role == 'client' && request.resource.data.status == 'active')
              || (request.resource.data.role == 'professional' && request.resource.data.status == 'pending')))
        );
      allow update: if admin(resource.data.businessId)
        && resource.data.userId != request.auth.uid
        && resource.data.userId != get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'professionalId'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['professionalId'])
          || (request.resource.data.professionalId is string
            && getAfter(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId)).data.userId == resource.data.userId
            && getAfter(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId)).data.businessId == resource.data.businessId))
        && request.resource.data.role in ['admin', 'professional', 'client']
        && request.resource.data.status in ['active', 'inactive']
        && professionalMatches(resource.data.businessId, resource.data.userId, request.resource.data.role, request.resource.data.status);
      allow delete: if self(resource.data.userId) && recent(resource.data) && provisioning();
    }
    match /professionals/{pid} {
      allow read: if self(resource.data.userId) || admin(resource.data.businessId);
      allow get: if managesProfile(pid);
      allow create: if admin(request.resource.data.businessId)
        && pid == request.resource.data.businessId + '_' + request.resource.data.userId
        && request.resource.data.id == pid && request.resource.data.serviceIds == []
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/memberships/$(pid)).data.role == 'professional'
        && request.resource.data.isActive == (getAfter(/databases/$(database)/documents/memberships/$(pid)).data.status == 'active');
      allow create: if userActive() && self(request.resource.data.userId)
        && pid == request.resource.data.businessId + '_' + request.auth.uid
        && request.resource.data.id == pid
        && member(request.resource.data.businessId).role == 'professional'
        && member(request.resource.data.businessId).status == 'pending'
        && request.resource.data.isActive == false
        && request.resource.data.serviceIds == []
        && request.resource.data.createdAt == request.time;
      allow update: if admin(resource.data.businessId) && sameIdentity()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['jobTitle', 'bio', 'phone', 'photo', 'isActive', 'serviceIds', 'weeklyHours', 'scheduleValidFrom', 'scheduleValidUntil', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive'])
          || request.resource.data.isActive == (
            getAfter(/databases/$(database)/documents/memberships/$(resource.data.businessId + '_' + resource.data.userId)).data.role == 'professional'
            && getAfter(/databases/$(database)/documents/memberships/$(resource.data.businessId + '_' + resource.data.userId)).data.status == 'active'));
      allow delete: if self(resource.data.userId) && recent(resource.data) && resource.data.isActive == false && provisioning();
    }
    match /clients/{cid} {
      allow read: if self(resource.data.userId) || admin(resource.data.businessId);
      allow get: if managesProfile(cid);
      allow create: if admin(request.resource.data.businessId)
        && cid == request.resource.data.businessId + '_' + request.resource.data.userId
        && request.resource.data.id == cid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/memberships/$(cid)).data.role == 'client';
      allow create: if userActive() && self(request.resource.data.userId)
        && cid == request.resource.data.businessId + '_' + request.auth.uid
        && request.resource.data.id == cid && member(request.resource.data.businessId).role == 'client'
        && member(request.resource.data.businessId).status == 'active'
        && request.resource.data.createdAt == request.time;
      allow delete: if self(resource.data.userId) && recent(resource.data) && provisioning();
    }
    match /categories/{cid} {
      allow read: if admin(resource.data.businessId)
        || professional(resource.data.businessId)
        || (activeMember(resource.data.businessId) && member(resource.data.businessId).role == 'client');
      allow create: if admin(request.resource.data.businessId) && request.resource.data.id == cid;
      allow update: if admin(resource.data.businessId) && sameIdentity();
    }
    match /services/{sid} {
      allow read: if (resource.data.get('isActive', false) == true && resource.data.get('isPublic', false) == true && publicBusiness(resource.data.businessId))
        || (resource.data.get('isActive', false) == true && resource.data.get('isPublic', false) == true
          && activeMember(resource.data.businessId) && member(resource.data.businessId).role == 'client')
        || admin(resource.data.businessId)
        || professional(resource.data.businessId);
      allow create: if admin(request.resource.data.businessId) && request.resource.data.id == sid
        && validService(request.resource.data);
      allow update: if admin(resource.data.businessId) && sameIdentity() && validService(request.resource.data);
      function validService(data) {
        return data.name is string && data.name.size() > 0 && data.price is number && data.price > 0
          && data.durationMinutes is int && data.durationMinutes > 0
          && data.get('bufferBeforeMinutes', 0) is int && data.get('bufferBeforeMinutes', 0) >= 0
          && data.get('bufferAfterMinutes', 0) is int && data.get('bufferAfterMinutes', 0) >= 0
          && get(/databases/$(database)/documents/categories/$(data.categoryId)).data.businessId == data.businessId;
      }
    }
    match /scheduleBlocks/{bid} {
      allow read: if admin(resource.data.businessId) || (professional(resource.data.businessId)
        && (resource.data.allProfessionals == true || ownProfessional(resource.data.businessId, resource.data.professionalId)));
      allow write: if false; // Validated transactionally by the booking server.
    }
    // Compatibilidad con las colecciones de fases posteriores ya existentes.
    function activeUser() { return userActive(); }
    function hasRole(businessId, roles) { return activeMember(businessId) && member(businessId).role in roles; }
    function isAdmin(businessId) { return admin(businessId); }
    function isProfessional(businessId) { return professional(businessId); }
    function sameBusiness() { return request.resource.data.businessId == resource.data.businessId; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    match /reservations/{id} {
      allow read: if superadmin() || (activeMember(resource.data.businessId) && (
        member(resource.data.businessId).role == 'admin'
        || (member(resource.data.businessId).role == 'professional' && resource.data.professionalUserId == request.auth.uid)
        || (member(resource.data.businessId).role == 'client' && resource.data.clientUserId == request.auth.uid)));
      // Solo el servidor autenticado puede validar y escribir una reserva y su bloqueo
      // de concurrencia en la misma transacción.
      allow write: if false;
    }
    match /bookingLocks/{id} {
      allow read, write: if false;
    }
    match /bookingRequests/{id} {
      allow read, write: if false;
    }
    // Sprint 3 writes are validated by the authenticated server.
    match /notifications/{id} {
      allow read: if (superadmin() || activeMember(resource.data.businessId)) && resource.data.recipientUserId == request.auth.uid;
      allow write: if false;
    }
    match /favorites/{id} {
      allow read: if activeMember(resource.data.businessId) && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /waitingList/{id} {
      allow read: if admin(resource.data.businessId) || (activeMember(resource.data.businessId) && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /reviews/{id} {
      allow read: if admin(resource.data.businessId) || (resource.data.status == 'published' && resource.data.isPublic == true && publicBusiness(resource.data.businessId));
      allow write: if false;
    }
    match /promotions/{id} {
      allow read: if admin(resource.data.businessId) || (resource.data.isActive == true && publicBusiness(resource.data.businessId));
      allow write: if false;
    }
    match /reminderSettings/{id} {
      allow read: if admin(resource.data.businessId);
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if isAdmin(resource.data.businessId);
      // Client events are accepted only alongside the actual atomic mutation.
      allow create: if admin(request.resource.data.businessId)
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (validBusinessAudit(request.resource.data) || validMembershipAudit(request.resource.data));
      allow update, delete: if false;
      function validBusinessAudit(data) {
        let before = get(/databases/$(database)/documents/businesses/$(data.businessId)).data;
        let after = getAfter(/databases/$(database)/documents/businesses/$(data.businessId)).data;
        return data.action == 'businessUpdate'
          && data.keys().hasOnly(['businessId', 'actorUserId', 'action', 'createdAt', 'beforeName', 'afterName', 'beforeAppearance', 'afterAppearance'])
          && after.updatedAt == request.time && before.get('updatedAt', null) != after.updatedAt
          && data.beforeName == before.get('name', '') && data.afterName == after.get('name', '')
          && data.beforeAppearance == before.get('appearance', {}) && data.afterAppearance == after.get('appearance', {});
      }
      function validMembershipAudit(data) {
        let mid = data.businessId + '_' + data.get('targetUserId', '');
        let before = get(/databases/$(database)/documents/memberships/$(mid)).data;
        let after = getAfter(/databases/$(database)/documents/memberships/$(mid)).data;
        return data.action == 'membershipUpdate'
          && data.keys().hasOnly(['businessId', 'actorUserId', 'action', 'createdAt', 'targetUserId', 'beforeRole', 'beforeStatus', 'afterRole', 'afterStatus'])
          && (before.role != after.role || before.status != after.status)
          && data.beforeRole == before.role && data.afterRole == after.role
          && data.beforeStatus == before.status && data.afterStatus == after.status;
      }
    }
    match /generatedReports/{id} {
      allow read: if isAdmin(resource.data.businessId);
      allow create: if isAdmin(request.resource.data.businessId)
                    && request.resource.data.generatedByUserId == request.auth.uid;
      allow update, delete: if isAdmin(resource.data.businessId);
    }
  }
}
